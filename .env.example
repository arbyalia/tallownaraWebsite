# Salin berkas ini menjadi .env lalu isi nilainya. Jangan commit .env.

# Aplikasi
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database lokal (Docker Compose)
# Port 5433 dipakai agar tidak bentrok dengan PostgreSQL lain di port 5432.
POSTGRES_USER=tallownara
POSTGRES_PASSWORD=ganti_kata_sandi_lokal
POSTGRES_DB=tallownara
POSTGRES_PORT=5433
DATABASE_URL=postgres://tallownara:ganti_kata_sandi_lokal@localhost:5433/tallownara

# Payload CMS. Buat nilai acak minimal 32 karakter: openssl rand -hex 32
PAYLOAD_SECRET=

# Pembayaran: midtrans | mock (mock = simulasi lokal, ditolak di produksi)
PAYMENT_PROVIDER=midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# Pengiriman: mock | biteship
SHIPPING_PROVIDER=mock
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_SECRET=
# Kode area agregator untuk gudang Tuban
SHIPPING_ORIGIN_AREA_ID=
SHIPPING_ORIGIN_POSTAL_CODE=

# WhatsApp: console | meta
WA_PROVIDER=console
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=

# Email: console | resend | smtp
EMAIL_PROVIDER=console
EMAIL_FROM=hello@tallownara.com
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# OTP riwayat pesanan. Buat nilai acak: openssl rand -hex 32
OTP_HASH_SECRET=

# Aturan toko
ORDER_EXPIRY_HOURS=24
COD_ENABLED=false
